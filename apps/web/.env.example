# Next.js loads env files from this app's own directory, not the monorepo
# root — copy this to apps/web/.env.local and fill in real values.

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Auth.js — session encryption secret, NOT the same as the API's JWT_SECRET.
NEXTAUTH_SECRET="replace-with-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"
