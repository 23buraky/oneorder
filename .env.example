# ============================================
# ONE ORDER — Environment Variables Template
# Copy to .env and fill in real values.
# Never commit the real .env file.
# ============================================

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=https://oneorderantwerp.com
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
API_PORT=4000

# --- Database (MySQL / MariaDB) ---
DATABASE_URL="mysql://one_order:password@localhost:3306/one_order"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- JWT / Auth.js ---
JWT_SECRET="replace-with-strong-random-secret"
JWT_REFRESH_SECRET="replace-with-strong-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
NEXTAUTH_SECRET="replace-with-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- OAuth Providers ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Resend (Emails) ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="ONE ORDER <no-reply@oneorderantwerp.com>"

# --- Firebase Cloud Messaging ---
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# --- Security ---
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
CORS_ORIGIN="http://localhost:3000"

# --- Business Config ---
DEFAULT_CURRENCY="EUR"
DEFAULT_LOCALE="nl"
SUPPORTED_LOCALES="nl,en,fr,tr"
